{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decision Frontmatter Schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "version",
    "created_by",
    "updated_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_by": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "updated_by": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "subject_id": {
      "type": "string"
    },
    "decision_type": {
      "type": "string",
      "enum": [
        "human_ruling",
        "agent_assumption",
        "cross_team_override",
        "pivot",
        "review_rejection",
        "lease_override"
      ]
    },
    "topic": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "ruling": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    }
  }
}
