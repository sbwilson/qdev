{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Story Transition Payload Schema",
  "description": "Output shape of `qdev transition story <id> <target_status> --json`. Schema changes follow semver on schema_version; additive fields do not bump the major.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "from_status",
    "to_status",
    "version",
    "closed_dw"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "from_status": {
      "type": "string",
      "minLength": 1
    },
    "to_status": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "closed_dw": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
