{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hygiene Payload Schema",
  "description": "Output shape of `qdev hygiene check --json`. Reports comment hygiene status, summary, and structured findings. Schema changes follow semver on schema_version; additive fields do not bump the major.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "summary",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "line",
          "location",
          "rule_id",
          "excerpt"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "location": {
            "type": "string"
          },
          "rule_id": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
