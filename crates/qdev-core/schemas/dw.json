{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deferred Work Frontmatter Schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "version",
    "created_by",
    "updated_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_by": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "updated_by": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "target_module": {
      "type": "string"
    },
    "origin_story_id": {
      "type": "string"
    },
    "safety_risk": {
      "type": "string",
      "enum": [
        "negligible",
        "acceptable_with_mitigation",
        "unacceptable"
      ]
    },
    "rationale": {
      "type": "string"
    },
    "gate": {
      "type": "string"
    },
    "resolution": {
      "type": "string"
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
