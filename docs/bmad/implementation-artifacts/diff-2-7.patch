+        .failure()
+        .code(2);
+
+    let val: Value = serde_json::from_slice(&assert.get_output().stdout).unwrap();
+    assert_eq!(val["error"]["code"], "usage_error");
+
+    // 5. Empty or whitespace topic -> Exit 2 usage_error
+    let mut cmd = Command::cargo_bin("qdev").unwrap();
+    let assert = cmd
+        .current_dir(root)
+        .args([
+            "decision",
