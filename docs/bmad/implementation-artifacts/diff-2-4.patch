+fn write_story(root: &Path, id: &str, title: &str, status: &str, owners: &[&str]) {
+    let stories_dir = root.join("docs/specs/stories");
+    fs::create_dir_all(&stories_dir).unwrap();
+    let owners_yaml = if owners.is_empty() {
+        String::new()
+    } else {
+        format!(
+            "owners:\n{}",
+            owners
+                .iter()
+                .map(|o| format!("  - \"{}\"", o))
+                .collect::<Vec<_>>()
+                .join("\n")
+        )
+    };
+
+    fs::write(
+        stories_dir.join(format!("{}.md", id)),
+        format!(
+            r#"---
+id: {id}
+title: "{title}"
+status: {status}
+version: 1
+created_by:
+  type: human
+  id: sally
+updated_by:
+  type: human
+  id: sally
+{owners_yaml}
+---
+
+## Acceptance Criteria
+- AC1.
+"#
+        ),
+    )
+    .unwrap();
+}
