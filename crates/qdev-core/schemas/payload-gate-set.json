{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gate Set Payload Schema",
  "description": "Output shape of `qdev gate run --all --json` and `qdev gate run --for-transition <name> --json`. Schema changes follow semver on schema_version; additive fields do not bump the major.",
  "type": "object",
  "required": [
    "schema_version",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate",
          "status",
          "exit_code",
          "duration_ms",
          "summary",
          "skipped_locally"
        ],
        "properties": {
          "gate": {
            "type": "string",
            "minLength": 1
          },
          "story": {
            "type": ["string", "null"]
          },
          "commit": {
            "type": ["string", "null"]
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "infra", "skip"]
          },
          "exit_code": {
            "type": "integer"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "summary": {
            "type": "string"
          },
          "skipped_locally": {
            "type": "boolean"
          },
          "stdout": {
            "type": ["string", "null"]
          },
          "stderr": {
            "type": ["string", "null"]
          },
          "agent_instruction": {
            "type": ["string", "null"]
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "location",
                "message"
              ],
              "properties": {
                "location": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "metric": {
            "type": ["number", "null"]
          },
          "constraint_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
