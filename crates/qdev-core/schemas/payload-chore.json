{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chore Payload Schema",
  "description": "Output shapes of the `qdev chore` commands. `start`, `close` and `abort` all return a chore record, `commit` returns the commit that honoured it, and `list` returns every record in the workspace — three shapes, so the schema picks between them with oneOf: a record always carries `id`/`title`/`paths`, a commit always carries `chore_id`/`committed`/`included`/`excluded`, a list always carries `chores`. Schema changes follow semver on schema_version; additive fields do not bump the major.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/choreRecord" },
    { "$ref": "#/definitions/choreCommitResult" },
    { "$ref": "#/definitions/choreList" }
  ],
  "definitions": {
    "author": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["human", "agent"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "choreRecord": {
      "required": [
        "schema_version",
        "id",
        "title",
        "paths",
        "author",
        "started_at",
        "status"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^chore-[a-z0-9-]+$",
          "minLength": 7
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "author": {
          "$ref": "#/definitions/author"
        },
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["open", "committed", "closed", "abandoned"]
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "type": "string",
          "pattern": "^DEC-[0-9a-f]{4,}$"
        },
        "decision_path": {
          "type": "string",
          "minLength": 1
        },
        "closed_at": {
          "type": "string",
          "minLength": 1
        },
        "closed_by": {
          "$ref": "#/definitions/author"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "choreCommitResult": {
      "required": [
        "schema_version",
        "chore_id",
        "committed",
        "included",
        "excluded"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "chore_id": {
          "type": "string",
          "pattern": "^chore-[a-z0-9-]+$",
          "minLength": 7
        },
        "committed": {
          "type": "boolean"
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "included": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "staged"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "staged": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "decision_id": {
          "type": "string",
          "pattern": "^DEC-[0-9a-f]{4,}$"
        },
        "decision_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "choreList": {
      "required": ["schema_version", "chores", "record_dir"],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "chores": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/choreRecord"
          }
        },
        "record_dir": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
