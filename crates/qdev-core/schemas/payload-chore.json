{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chore Payload Schema",
  "description": "Output shape of `qdev chore start --json` (the recorded chore) and `qdev chore commit --json` (the commit that honoured it). The two commands return different shapes, so the schema picks between them with oneOf: a start always carries `id`/`title`/`paths`, a commit always carries `chore_id`/`committed`/`included`/`excluded`. Schema changes follow semver on schema_version; additive fields do not bump the major.",
  "type": "object",
  "oneOf": [
    {
      "required": [
        "schema_version",
        "id",
        "title",
        "paths",
        "author",
        "started_at",
        "status"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^chore-[a-z0-9-]+$",
          "minLength": 7
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "author": {
          "type": "object",
          "required": ["type", "id"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["human", "agent"]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["open", "committed"]
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "type": "string",
          "pattern": "^DEC-[0-9a-f]{4,}$"
        }
      },
      "additionalProperties": false
    },
    {
      "required": [
        "schema_version",
        "chore_id",
        "committed",
        "included",
        "excluded"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "chore_id": {
          "type": "string",
          "pattern": "^chore-[a-z0-9-]+$",
          "minLength": 7
        },
        "committed": {
          "type": "boolean"
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "included": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "staged"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "staged": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "decision_id": {
          "type": "string",
          "pattern": "^DEC-[0-9a-f]{4,}$"
        },
        "decision_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  ]
}
