{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Epic Frontmatter Schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "version",
    "created_by",
    "updated_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_by": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "updated_by": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phase": {
      "type": [
        "string",
        "integer"
      ]
    },
    "appetite": {
      "type": "string",
      "enum": [
        "tiny",
        "small",
        "medium",
        "deep"
      ]
    },
    "target_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "no_go",
              "rabbit_hole",
              "appetite"
            ]
          },
          "text": {
            "type": "string"
          },
          "inherited_from": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "object",
      "properties": {
        "governed_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "traces_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
