{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SOUP Dependency Frontmatter Schema",
  "type": "object",
  "required": [
    "id",
    "status",
    "version",
    "created_by",
    "updated_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_by": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "updated_by": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "name": {
      "type": "string"
    },
    "dependency_version": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "cve_status": {
      "type": "string"
    },
    "introduced_by_story": {
      "type": "string"
    },
    "evaluated_for_release": {
      "type": "string"
    }
  }
}
